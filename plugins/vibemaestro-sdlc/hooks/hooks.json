{
  "description": "Delivers the plugin's process and rules into a session opened in an app repo, and a short core into each subagent that can edit; silent when the config sets hooks: off, except the guard of the owner's baton signature",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/pyrun.sh\" --say \"scripts/session-start.py\" core",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/pyrun.sh\" \"scripts/session-start.py\" context",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/pyrun.sh\" \"scripts/session-start.py\" index",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/pyrun.sh\" \"scripts/update_check.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/pyrun.sh\" \"scripts/quiet_save.py\" save",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(?!(?:Explore|Plan|claude-code-guide|statusline-setup)$).*$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/pyrun.sh\" \"scripts/session-start.py\" subagent",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/pyrun.sh\" \"scripts/pre-edit.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/pyrun.sh\" \"scripts/pre-bash.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/pyrun.sh\" \"scripts/baton-guard.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/pyrun.sh\" \"scripts/settings-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
