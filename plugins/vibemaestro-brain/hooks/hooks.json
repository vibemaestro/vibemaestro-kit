{
  "description": "vibemaestro-brain: re-inject the left and the right brain (up to 14 strings of 9,500 each) after every compaction; log compactions; guard writes; remind of a newer public version",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" session-start", "timeout": 10},
                              {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" session-start-2", "timeout": 10},
                              {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" session-start-3", "timeout": 10},
                              {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" session-start-4", "timeout": 10},
                              {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" session-start-5", "timeout": 10},
                              {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" session-start-6", "timeout": 10},
                              {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" session-start-7", "timeout": 10},
                              {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" session-start-8", "timeout": 10},
                              {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" session-start-9", "timeout": 10},
                              {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" session-start-10", "timeout": 10},
                              {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" session-start-11", "timeout": 10},
                              {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" session-start-12", "timeout": 10},
                              {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" session-start-13", "timeout": 10},
                              {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" session-start-14", "timeout": 10},
                              {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" update-check", "timeout": 10}]}],
    "PreCompact": [{"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" pre-compact", "timeout": 10}]}],
    "PostCompact": [{"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" post-compact", "timeout": 10}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" session-end"}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" prompt", "timeout": 10}]}],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "if": "Bash(brain op *)", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" guard-bash", "timeout": 10},
                                    {"type": "command", "if": "Bash(brain import *)", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" guard-bash", "timeout": 10},
                                    {"type": "command", "if": "Bash(brain *)", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" note-format", "timeout": 10}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" guard-owner", "timeout": 30}]},
      {"matcher": "Edit|Write|NotebookEdit", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brain_hook.py\" guard-edit", "timeout": 10}]}
    ]
  }
}
