{
  "schema": 1,
  "merge": {
    "deny_globs": [
      ".github/workflows/**",
      ".github/actions/**",
      ".claude-plugin/**",
      ".vibemaestro/**",
      "**/*.sops",
      "**/*.sops.*",
      "**/kubeconfig",
      "**/kubeconfig.*",
      "**/kubeconfig-*",
      "**/*.kubeconfig",
      "**/*.kubeconfig.*",
      "**/*-kubeconfig",
      "**/*-kubeconfig.*",
      "**/.kube/**"
    ],
    "admin_bypass": true,
    "required_checks": [
      "bash tests/run-all.sh",
      "internal-term scan"
    ]
  },
  "current_state": {
    "pages": "kb/state/*.md"
  },
  "public": {
    "private": [
      ".vibemaestro/sdlc.json"
    ]
  }
}
